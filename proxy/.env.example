# CC-Flux Configuration
# Copy this file to .env and fill in your values

# Server Port
PORT=8080

# Target Provider: openai, deepseek, ollama
TARGET_PROVIDER=deepseek

# API Base URL
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com
# Ollama: http://localhost:11434/v1
TARGET_BASE_URL=https://api.deepseek.com

# API Key (your API key here)
TARGET_API_KEY=your-api-key-here

# Model Name
# OpenAI: gpt-4o, gpt-4o-mini
# DeepSeek: deepseek-reasoner, deepseek-chat
# Ollama: llama3, qwen2, etc.
TARGET_MODEL=deepseek-reasoner

# Enable retry for local models (ollama)
RETRY_ENABLED=false

# Unix Socket Path (optional, for higher performance)
# Windows: \\.\pipe\cc-flux
# Linux/Mac: /tmp/cc-flux.sock
# SOCKET_PATH=
